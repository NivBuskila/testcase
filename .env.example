# DecisionForge AI — Live Mode configuration.
# Without any key the app runs in Mock Mode (fully simulated debates).
# Set ONE of the provider keys below to enable Live Mode.
# If both are set, OpenAI is used unless AI_PROVIDER=anthropic.

AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
